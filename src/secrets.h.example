// Copy this file to secrets.h and fill in your own values.
// secrets.h is listed in .gitignore and should NEVER be committed.

#define WIFI_SSID        "YourNetworkName"
#define WIFI_PASSWORD    "YourWiFiPassword"

#define MQTT_BROKER_IP   "xxxx.s1.eu.hivemq.cloud"  // from your HiveMQ console
#define MQTT_BROKER_PORT 8883                         // always 8883 for TLS
#define MQTT_USER        "your-mqtt-username"
#define MQTT_PASSWORD    "your-mqtt-password"
#define MQTT_CLIENT_ID   "your-device-id"      // must be unique per device

#define DEVICE_ID        "your-device-id"
#define PATIENT_ID       "your-patient-id"           // used in the MQTT topic: vitals/<PATIENT_ID>
